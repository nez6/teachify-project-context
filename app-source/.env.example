# Google Cloud: Gemini on Vertex AI. Uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Anthropic only words a teacher hint after SymPy decides the math verdict.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Voice. Keep the private Deepgram and Vapi keys on the server. The Vapi web
# client receives only the provider-designated public key and assistant ID.
DEEPGRAM_API_KEY=
VAPI_PUBLIC_API_KEY=
VAPI_PRIVATE_API_KEY=
VAPI_ASSISTANT_ID=

# Thinking Machines: Tinker needs both values. TINKER_MODEL is a sampler
# checkpoint path, such as tinker://<id>:train:0/sampler_weights/<step>.
TINKER_API_KEY=
TINKER_MODEL=

# Entrinsik Informer: the reporting feed at /api/informer/{attempts,alerts,misconceptions}
# stays off until this is set. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INFORMER_TOKEN=

# Desk camera: POST /api/capture/{device_id} stays off until this is set. The
# camera sends it as the X-Device-Token header. It is never sent to browsers.
DEVICE_TOKEN=
